# NASA FIRMS map key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Optional: without it the pipeline uses the public SE-Asia 7-day CSVs.
FIRMS_MAP_KEY=

# Optional MapTiler key for basemap + hillshade; otherwise OpenFreeMap is used.
VITE_MAPTILER_KEY=

# Public origin of the deployed site, used for og:image / og:url (no trailing slash).
SITE_URL=https://kwanmajaknai.pages.dev

# Cloudflare Pages deploy (wrangler)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=kwanmajaknai
